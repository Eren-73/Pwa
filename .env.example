# d:\Freelance\Python_Dev\Pwa\.env.example
# Variables d'environnement pour le déploiement Docker en entreprise.
# Ce fichier sert de modèle pour définir secrets et IP réseau local.
# RELEVANT FILES:docker-compose.yml, Devis/settings.py, Dockerfile

DJANGO_DEBUG=False
DJANGO_REQUIRE_POSTGRES=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Mets l'IP LAN du serveur physique entreprise.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://192.168.1.100
SITE_URL=http://192.168.1.100

POSTGRES_DB=devis_db
POSTGRES_USER=devis_user
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
